---
- name: Installation Cluster Kubernetes 1.32 (Master & Workers)
  hosts: kube_cluster  # Utilisation de ton groupe 'kube_cluster'
  become: yes
    
  tasks:
    # ---------------------------------------------------------
    # 1. PRÉPARATION SYSTÈME (SWAP, MODULES, SYSCTL)
    # ---------------------------------------------------------
    - name: Désactiver le swap (immédiat)
      command: swapoff -a
      when: ansible_swaptotal_mb > 0

    - name: Désactiver le swap (fstab)
      replace:
        path: /etc/fstab
        regexp: '^([^#].*?\sswap\s+sw\s+.*)$'
        replace: '# \1'

    - name: Charger et persister les modules du noyau
      modprobe:
        name: "{{ item }}"
        state: present
      loop: [overlay, br_netfilter]

    - name: Configurer sysctl pour le réseau K8s
      copy:
        dest: /etc/sysctl.d/k8s.conf
        content: |
          net.bridge.bridge-nf-call-iptables  = 1
          net.bridge.bridge-nf-call-ip6tables = 1
          net.ipv4.ip_forward                 = 1
      register: sysctl_config

    - name: Appliquer les changements sysctl
      command: sysctl --system
      when: sysctl_config.changed

    # ---------------------------------------------------------
    # 2. INSTALLATION DES DÉPENDANCES ET CONTAINERD
    # ---------------------------------------------------------
    - name: Installer les dépendances système de base
      apt:
        name: [apt-transport-https, ca-certificates, curl, gpg, software-properties-common]
        state: present
        update_cache: yes

    - name: Installer Containerd
      apt:
        name: containerd
        state: present

    - name: Créer le dossier de config containerd
      file:
        path: /etc/containerd
        state: directory

    - name: Générer la config containerd par défaut
      shell: containerd config default > /etc/containerd/config.toml
      changed_when: false

    # CRUCIAL POUR UBUNTU 24.04 : SystemdCgroup
    - name: Configurer SystemdCgroup = true dans containerd
      replace:
        path: /etc/containerd/config.toml
        regexp: 'SystemdCgroup = false'
        replace: 'SystemdCgroup = true'
      notify: Restart containerd

    # ---------------------------------------------------------
    # 3. AJOUT DU DÉPÔT KUBERNETES ET INSTALLATION BINAIRES
    # ---------------------------------------------------------
    - name: Télécharger la clé GPG Kubernetes (v{{ k8s_version }})
      get_url:
        url: "https://pkgs.k8s.io/core:/stable:/v{{ k8s_version }}/deb/Release.key"
        dest: /etc/apt/keyrings/kubernetes-apt-keyring.asc
        mode: '0644'
        force: yes

    - name: Ajouter le dépôt Kubernetes APT
      apt_repository:
        repo: "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.asc] https://pkgs.k8s.io/core:/stable:/v{{ k8s_version }}/deb/ /"
        filename: kubernetes
        state: present

    - name: Installer Kubelet, Kubeadm, Kubectl
      apt:
        name: [kubelet, kubeadm, kubectl]
        state: present
        update_cache: yes

    - name: Bloquer la version des paquets
      dpkg_selections:
        name: "{{ item }}"
        selection: hold
      loop: [kubelet, kubeadm, kubectl]

  handlers:
    - name: Restart containerd
      service:
        name: containerd
        state: restarted


# ---------------------------------------------------------
# 4. INITIALISATION DU MASTER (Uniquement sur le groupe 'kube_master')
# ---------------------------------------------------------
- name: Configuration du Master Node
  hosts: kube_master # Utilisation de ton groupe 'kube_master'
  become: yes
  tasks:
    - name: Initialiser le Cluster (kubeadm init)
      command: kubeadm init --pod-network-cidr={{ pod_network_cidr }}
      args:
        creates: /etc/kubernetes/admin.conf
      register: kubeadm_init

    - name: Créer le dossier .kube pour l'utilisateur '{{ ansible_user }}'
      file:
        path: "/home/{{ ansible_user }}/.kube"
        state: directory
        owner: "{{ ansible_user }}"
        group: "{{ ansible_user }}"
        mode: 0755

    - name: Copier le fichier admin.conf vers .kube/config
      copy:
        src: /etc/kubernetes/admin.conf
        dest: "/home/{{ ansible_user }}/.kube/config"
        remote_src: yes
        owner: "{{ ansible_user }}"
        group: "{{ ansible_user }}"
        # Rendre le fichier lisible par l'utilisateur 'kube' pour kubectl
        remote_src: yes

    # Installation de CALICO via Tigera Operator
    - name: Installer Calico (CNI) via l'Opérateur
      become_user: "{{ ansible_user }}"
      command: kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.29.1/manifests/tigera-operator.yaml
      ignore_errors: yes

    - name: Configurer les Custom Resources Calico
      become_user: "{{ ansible_user }}"
      command: kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.29.1/manifests/custom-resources.yaml
      ignore_errors: yes

    - name: Créer le token de jonction
      command: kubeadm token create --print-join-command
      register: join_command_output

    - name: Stocker la commande de join dans une variable factice
      add_host:
        name: "K8S_TOKEN_HOLDER"
        join_cmd: "{{ join_command_output.stdout }}"


# ---------------------------------------------------------
# 5. JONCTION DES WORKERS (Uniquement sur le groupe 'kube_node')
# ---------------------------------------------------------
- name: Jonction des Workers Nodes
  hosts: kube_node # Utilisation de ton groupe 'kube_node'
  become: yes
  tasks:
    - name: Rejoindre le cluster
      # On utilise la variable stockée par le master
      command: "{{ hostvars['K8S_TOKEN_HOLDER']['join_cmd'] }}" 
      args:
        creates: /etc/kubernetes/kubelet.conf